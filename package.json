{
  "name": "compatlens",
  "version": "1.0.0",
  "description": "A DevTools panel for Chrome and Firefox that watches the inspected page and reports cross-browser compatibility risks in its HTML and CSS, entirely locally.",
  "license": "Apache-2.0",
  "author": "Faran Ali",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faran52/compatlens.git"
  },
  "homepage": "https://github.com/Faran52/compatlens#readme",
  "bugs": {
    "url": "https://github.com/Faran52/compatlens/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.20.0"
  },
  "scripts": {
    "build": "vite build",
    "build:preview": "vite build --mode preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "generate": "vite-node src/lib/compat-data/scripts/writeRegistry.ts",
    "icons": "node scripts/generateIcons.js",
    "screenshots": "node scripts/captureScreenshots.js",
    "package": "pnpm build && node scripts/packageExtension.js"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "parse5": "8.0.1",
    "postcss": "8.5.25",
    "postcss-selector-parser": "7.1.4",
    "postcss-value-parser": "4.2.0"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "8.0.9",
    "@playwright/test": "1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "baseline-browser-mapping": "2.11.12",
    "eslint": "10.8.0",
    "eslint-config-lintel": "0.1.0",
    "happy-dom": "20.11.1",
    "sharp": "0.35.3",
    "solid-js": "^1.9.14",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vite-node": "^6.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "4.1.10",
    "web-features": "3.34.3"
  }
}
